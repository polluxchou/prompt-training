# ---- DeepSeek 代理后端 ----
# 必填：你的 DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：上游 API 地址（默认 DeepSeek 官方端点）
# 如果是 DeepSeek V4 或其他兼容 OpenAI 协议的端点，改这里即可
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：每 IP 每分钟最大请求次数（默认 30，30 人同时点也能扛住）
RATE_LIMIT_PER_MIN=30

# 可选：代理服务端口（默认 3001）
PORT=3001

# 可选：CORS 白名单（生产部署必填），逗号分隔多个 origin
# 例：ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
# 留空 = 允许所有 origin（仅适用于本地开发）
ALLOWED_ORIGINS=

# ---- Supabase（邀请码注册系统） ----
# Supabase 项目 URL，形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=

# 服务端专用，绝不要泄漏到前端
SUPABASE_SERVICE_ROLE_KEY=

# 前端 anon key（Vite 会读 VITE_ 前缀的变量）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 前端：后端 API 地址 ----
# 本地开发留空（fetch 走相对路径 → Vite proxy → localhost:3001）
# Vercel 部署时必填：你的 Fly.io 后端域名
# 例：VITE_API_BASE=https://prompt-training-api.fly.dev
VITE_API_BASE=
