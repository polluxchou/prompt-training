# ---- DeepSeek 代理后端 ----
# 必填：你的 DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：上游 API 地址（默认 DeepSeek 官方端点）
# 如果是 DeepSeek V4 或其他兼容 OpenAI 协议的端点，改这里即可
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：每 IP 每分钟最大请求次数（默认 30，30 人同时点也能扛住）
RATE_LIMIT_PER_MIN=30

# 可选：代理服务端口（默认 3001）
PORT=3001

# ---- Supabase（邀请码注册系统） ----
# Supabase 项目 URL，形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=

# 服务端专用，绝不要泄漏到前端
SUPABASE_SERVICE_ROLE_KEY=

# 前端 anon key（Vite 会读 VITE_ 前缀的变量）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
